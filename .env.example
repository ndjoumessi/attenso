# Copier en .env puis `set -a; source .env; set +a` avant de lancer l'application.
#
# Trois blocs : ce qui est OBLIGATOIRE, ce qui l'est en production, et ce qui
# est facultatif. Chaque réglage facultatif absent éteint sa fonction sans
# jamais arrêter la file — c'est la règle tenue partout dans ce produit.

# --- Obligatoire ---------------------------------------------------------
# Secret de signature des jetons du personnel. Aucune valeur par défaut :
# l'application refuse de démarrer sans lui.
#   openssl rand -base64 48
ATTENSO_JWT_SECRET=remplace-moi-par-48-octets-aleatoires-en-base64

# --- Production ----------------------------------------------------------
# Base des liens envoyés par SMS. Doit rester COURTE : elle entre dans chaque
# message, et un segment facturé fait 160 caractères.
ATTENSO_BASE_URL=https://exemple.fr

# Les DEUX rôles Postgres. Un seul rendrait les politiques RLS inertes, et
# tous les tests de cloisonnement seraient verts pour rien.
DB_URL=jdbc:postgresql://base:5432/attenso
DB_USER=attenso_app
DB_PASSWORD=remplace-moi
DB_OWNER=postgres
DB_OWNER_PASSWORD=remplace-moi-aussi

# Mot de passe du Postgres local de développement uniquement.
POSTGRES_PASSWORD=attenso_dev

# --- Facultatif ----------------------------------------------------------
# Envoi réel des SMS. Sans ces deux-là, tout est journalisé et le coût calculé
# pour de vrai, mais rien ne part.
ATTENSO_OCTOPUSH_LOGIN=
ATTENSO_OCTOPUSH_CLE=

# Notifications poussées (EF-307). Sans clés, aucun abonnement n'est proposé
# au client et tout repart en SMS.
#   Génération : openssl ecparam -name prime256v1 -genkey -noout
#   puis encoder la paire en base64url (voir README).
ATTENSO_PUSH_CLE_PUBLIQUE=
ATTENSO_PUSH_CLE_PRIVEE=

# Alerte de supervision (EF-903). Sans webhook, tout reste journalisé, ce
# qu'un agrégateur de journaux exploite très bien.
ATTENSO_SUPERVISION_WEBHOOK=

# --- Souscription payante (Stripe) ---------------------------------------
# Sans ces réglages, l'application tourne mais PERSONNE NE PEUT SOUSCRIRE :
# la page d'inscription refuse, et le démarrage le journalise. Les cliniques
# déjà ouvertes ne sont pas affectées.
#
# La clé est SECRÈTE (sk_live_… en production, sk_test_… pour essayer).
ATTENSO_STRIPE_CLE=
# Secret de signature des webhooks (whsec_…), donné par Stripe à la création
# du point de terminaison. C'est le SEUL mécanisme qui authentifie la route
# /api/paiement/webhook : sans lui, n'importe qui s'offrirait un abonnement.
ATTENSO_STRIPE_WEBHOOK=
# Un identifiant de tarif Stripe (price_…) par palier, en abonnement mensuel.
ATTENSO_STRIPE_PRIX_COMPTOIR=
ATTENSO_STRIPE_PRIX_CLINIQUE=
ATTENSO_STRIPE_PRIX_CENTRE=

# --- Identité de l'éditeur (mentions légales) ----------------------------
# Obligatoire pour vendre : la loi impose de publier ces informations. Le
# démarrage journalise une ERREUR si la souscription est ouverte sans elles.
# Forme juridique, capital, RCS et TVA sont facultatifs — une entreprise
# individuelle n'en a pas.
ATTENSO_EDITEUR_DENOMINATION=
ATTENSO_EDITEUR_FORME=
ATTENSO_EDITEUR_CAPITAL=
ATTENSO_EDITEUR_SIEGE=
ATTENSO_EDITEUR_SIRET=
ATTENSO_EDITEUR_RCS=
ATTENSO_EDITEUR_TVA=
ATTENSO_EDITEUR_DIRECTEUR=
ATTENSO_EDITEUR_EMAIL=
ATTENSO_EDITEUR_TELEPHONE=
# L'hébergeur est exigé par la LCEN : le visiteur doit pouvoir le joindre si
# l'éditeur ne répond pas.
ATTENSO_EDITEUR_HEBERGEUR=
ATTENSO_EDITEUR_HEBERGEUR_ADRESSE=

# --- Courriel (récupération de mot de passe) -----------------------------
# Sans ces réglages, une clinique qui perd son mot de passe ne peut PAS le
# récupérer seule. N'importe quel serveur SMTP convient ; en prendre un
# européen garde la promesse de la politique de confidentialité.
SMTP_HOTE=
SMTP_PORT=587
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
ATTENSO_COURRIEL_EXPEDITEUR=
